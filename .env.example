# Copia este archivo a ".env" y coloca tus propios valores.
# El archivo ".env" real NO debe subirse a Git (ya está en .gitignore).

# Datos de conexión a MySQL/MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=biblioteca_user
DB_PASSWORD=cambia_esta_clave
DB_NAME=biblioteca_digital

# Clave usada por Flask para firmar la sesión y los mensajes flash.
# Cambien este valor por algo aleatorio antes de usar el proyecto en producción.
SECRET_KEY=cambia-esta-clave-por-una-aleatoria
